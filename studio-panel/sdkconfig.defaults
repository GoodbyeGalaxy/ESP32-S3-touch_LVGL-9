# Studio Panel — committed defaults (keine Credentials hier!)
# WiFi-Credentials in sdkconfig.defaults.local eintragen (gitignored).
CONFIG_ESP_WIFI_SSID=""
CONFIG_ESP_WIFI_PASSWORD=""

# ── Flash: Waveshare ESP32-S3-Touch-LCD-7 (16MB OPI) ─────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ── PSRAM: 8MB OPI (Octal SPI, 80MHz) ────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

# ── TinyUSB — USB MIDI Class Device ──────────────────────────────────────────
CONFIG_TINYUSB_MIDI_COUNT=1
