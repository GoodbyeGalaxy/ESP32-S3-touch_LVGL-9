# Studio Panel — committed defaults (keine Credentials hier!)
# WiFi-Credentials in sdkconfig.defaults.local eintragen (gitignored).
CONFIG_ESP_WIFI_SSID=""
CONFIG_ESP_WIFI_PASSWORD=""
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

# ── TinyUSB — USB MIDI Class Device ──────────────────────────────────────────
CONFIG_TINYUSB_MIDI_COUNT=1
